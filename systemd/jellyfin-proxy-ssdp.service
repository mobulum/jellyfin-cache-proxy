[Unit]
Description=Jellyfin Proxy SSDP Announcer and Responder
After=network.target nginx.service jellyfin.service
Wants=nginx.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/local/bin/jellyfin-proxy-ssdp.py
Restart=always
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
